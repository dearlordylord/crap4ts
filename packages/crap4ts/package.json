{
  "name": "@crap4ts/crap4ts",
  "version": "1.0.1",
  "description": "A thin npm launcher for the crap4ts TypeScript CRAP quality gate",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "crap4ts": "bin/crap4ts.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "optionalDependencies": {
    "@crap4ts/darwin-arm64": "1.0.1",
    "@crap4ts/darwin-x64": "1.0.1",
    "@crap4ts/linux-arm64": "1.0.1",
    "@crap4ts/linux-x64": "1.0.1",
    "@crap4ts/win32-x64": "1.0.1"
  },
  "scripts": {
    "pretest": "node ../../scripts/npm-smoke.js",
    "test": "node --test --test-concurrency=1 test/npm.test.js"
  }
}

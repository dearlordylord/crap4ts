    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/crap4ts.git",
    "directory": "packages/crap4ts"
  },
  "homepage": "https://github.com/dearlordylord/crap4ts#readme",
  "bugs": {
    "url": "https://github.com/dearlordylord/crap4ts/issues"
  },
  "type": "commonjs",
  "bin": {
